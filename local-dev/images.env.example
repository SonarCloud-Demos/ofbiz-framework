# Phase 1 permits these public, digest-pinned images. Re-resolve and review a
# digest explicitly when upgrading; never replace a digest with a floating tag.
MODERN_JAVA_BUILD_IMAGE=gradle:8.14.3-jdk21@sha256:21bd311ed01360c189b8870c6b6e988199ff10f72d445d02fb39d3cff9da91d7
MODERN_JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine@sha256:1a29e1fe337eb28b5bec30f0ee8ed29f0ff80ab6f75dcf9313efe82911065a52
MODERN_STATIC_WEB_IMAGE=nginxinc/nginx-unprivileged:1.29.1-alpine@sha256:27985295bdb22a1ef8f712863210bd5877c0f3006494a593e86b3fe0fa55467e
MODERN_POSTGRES_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
MODERN_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.136.0@sha256:45392d534c1edcc809c2d112394029246bc679d2ae5ea7081414a1fc74f2c621
MODERN_OFBIZ_IMAGE=ghcr.io/apache/ofbiz:trunk-snapshot@sha256:5bba6db4174932c18f8d4e7d82db2ca0fbdff22f1cd359f7f5215677845ce757

# Non-secret identity coordinates for a development OIDC client. Put both
# secrets in ignored files and point the *_FILE variables at them.
ENTRA_CLIENT_ID=replace-with-development-client-id
ENTRA_ISSUER_URI=https://login.microsoftonline.com/replace-with-tenant-id/v2.0
ENTRA_AUTHORIZATION_URI=https://login.microsoftonline.com/replace-with-tenant-id/oauth2/v2.0/authorize
ENTRA_TOKEN_URI=https://login.microsoftonline.com/replace-with-tenant-id/oauth2/v2.0/token
ENTRA_JWK_SET_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys
ENTRA_ALLOWED_TENANTS=replace-with-tenant-id
LEGACY_BRIDGE_AUDIENCE=ofbiz-legacy
ENTRA_CLIENT_SECRET_FILE=local-dev/secrets/entra-client-secret
LEGACY_BRIDGE_SIGNING_KEY_FILE=local-dev/secrets/legacy-bridge-signing-key
